{
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "(welcome|visit)\\..*" }],
      "dest": "/welcome.html"
    },
    {
      "src": "/d/[^/]+/?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/dashboard.html"
    },
    { "handle": "filesystem" }
  ]
}
